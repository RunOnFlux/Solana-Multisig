{
    "name": "@self-initiating-multisig/truly-self-initiating-sdk",
    "version": "0.1.0",
    "description": "TypeScript SDK for Truly Self-Initiating Multisig with Collective Approval",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "mocha --require ts-node/register 'src/**/*.test.ts'",
        "test:watch": "mocha --require ts-node/register 'src/**/*.test.ts' --watch",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write src/**/*.ts",
        "format:check": "prettier --check src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "example:truly-self-init": "ts-node examples/truly-self-initiating-example.ts",
        "fund-accounts": "ts-node fund-accounts.ts"
    },
    "keywords": [
        "solana",
        "multisig",
        "squads",
        "blockchain",
        "crypto",
        "web3"
    ],
    "author": "Self-Initiating Multisig Team",
    "license": "MIT",
    "dependencies": {
        "@coral-xyz/anchor": "^0.29.0",
        "@solana/web3.js": "^1.87.6",
        "@sqds/multisig": "^2.1.3",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "@types/chai": "^4.3.0",
        "@types/mocha": "^10.0.0",
        "@types/node": "^18.15.0",
        "@typescript-eslint/eslint-plugin": "^5.57.0",
        "@typescript-eslint/parser": "^5.57.0",
        "chai": "^4.3.0",
        "eslint": "^8.37.0",
        "mocha": "^10.2.0",
        "prettier": "^2.8.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.0.0"
    },
    "files": [
        "dist/**/*",
        "idl/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/your-repo/self-initiating-multisig"
    }
}