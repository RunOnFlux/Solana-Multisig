{
  "name": "@runonflux/solana-multisig",
  "version": "0.5.1",
  "description": "TypeScript SDK for SSP Solana Multisig",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/idl && cp src/idl/solana_multisig.json dist/idl/",
    "test": "mocha -r ts-node/register tests/**/*.test.ts",
    "example": "ts-node examples/full-flow.ts",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "solana",
    "multisig",
    "self-initiating",
    "blockchain"
  ],
  "author": "Tadeas Kmenta <tadeas@runonflux.com>",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  }
}
